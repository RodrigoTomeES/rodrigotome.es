---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<section
  class:list={[className]}
  id="spotify"
  aria-label="Currently playing on Spotify"
>
  <h2
    class="mb-4 text-xs font-semibold uppercase tracking-widest text-neutral-400"
  >
    Now Playing
  </h2>
  <div class="flex items-center gap-3 text-sm text-cv-muted">
    <svg
      class="h-5 w-5 flex-shrink-0 fill-brand-green"
      viewBox="0 0 496 512"
      aria-hidden="true"
    >
      <path
        d="M248 8C111.1 8 0 119.1 0 256s111.1 248 248 248 248-111.1 248-248S384.9 8 248 8zm100.7 364.9c-4.2 0-6.8-1.3-10.7-3.6-62.4-37.6-135-39.2-206.7-24.5-3.9 1-9 2.6-11.9 2.6-9.7 0-15.8-7.7-15.8-15.8 0-10.3 6.1-15.2 13.6-16.8 81.9-18.1 165.6-16.5 237 26.2 6.1 3.9 9.7 7.4 9.7 16.5s-7.1 15.4-15.2 15.4zm26.9-65.6c-5.2 0-8.7-2.3-12.3-4.2-62.5-37-155.7-51.9-238.6-29.4-4.8 1.3-7.4 2.6-11.9 2.6-10.7 0-19.4-8.7-19.4-19.4s5.2-17.8 15.5-20.7c27.8-7.8 56.2-13.6 97.8-13.6 64.9 0 127.6 16.1 177 45.5 8.1 4.8 11.3 11 11.3 19.7-.1 10.8-8.5 19.5-19.4 19.5zm31-76.2c-5.2 0-8.4-1.3-12.9-3.9-71.2-42.5-198.5-52.7-280.9-29.7-3.6 1-8.1 2.6-12.9 2.6-13.2 0-23.3-10.3-23.3-23.6 0-13.6 8.4-21.3 17.4-23.9 35.2-10.3 74.6-15.2 117.5-15.2 73 0 149.5 15.2 205.4 47.8 7.8 4.5 12.9 10.7 12.9 22.6 0 13.6-11 23.3-23.2 23.3z"
      ></path>
    </svg>
    <span class="idle-text">Nothing playing right now</span>
  </div>
</section>

<template>
  <div class="flex items-center gap-4">
    <img
      id="spotify-album-art"
      alt=""
      class="h-12 w-12 flex-shrink-0 rounded object-cover"
    />
    <div class="min-w-0 flex-1">
      <a
        id="spotify-song-link"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="block truncate text-sm font-semibold text-neutral-900 transition-colors hover:text-brand-green"
      >
        <span id="spotify-song-title"></span>
      </a>
      <p id="spotify-artist-name" class="truncate text-xs text-cv-muted"></p>
      <div class="mt-1.5 flex items-center gap-2">
        <div
          id="spotify-progress-wrapper"
          class="spotify-progress-track flex-1"
          role="progressbar"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          aria-label="Song progress"
        >
          <div id="spotify-progress-fill" class="spotify-progress-fill"></div>
        </div>
        <span id="spotify-current-time" class="text-[10px] text-neutral-400"
          >00:00</span
        >
      </div>
    </div>
  </div>
</template>

<style>
  .spotify-progress-track {
    width: 100%;
    height: 3px;
    border-radius: 1.5px;
    background: #e5e5e5;
    position: relative;
    overflow: hidden;
  }

  .spotify-progress-fill {
    height: 100%;
    border-radius: 1.5px;
    background: #1ed760;
    width: 0%;
    transition: width 0.3s linear;
  }
</style>

<script>
  window.addEventListener('load', async () => {
    try {
      const response = await fetch(`${import.meta.env.BASE_URL}api/spotify`);
      const data = await response.json();

      if (data.isPlaying) {
        const spotifyElement = document.getElementById('spotify');
        const template = document.querySelector(
          'template',
        ) as HTMLTemplateElement;

        if (template && spotifyElement) {
          const card = template.content.cloneNode(true) as DocumentFragment;

          const albumArtImg = card.querySelector(
            '#spotify-album-art',
          ) as HTMLImageElement;
          const songTitle = card.querySelector(
            '#spotify-song-title',
          ) as HTMLElement;
          const artistName = card.querySelector(
            '#spotify-artist-name',
          ) as HTMLElement;
          const songLink = card.querySelector(
            '#spotify-song-link',
          ) as HTMLAnchorElement;

          if (albumArtImg) {
            albumArtImg.src = data.cover;
            albumArtImg.alt = `Album artwork for ${data.album} by ${data.artist}`;
          }
          if (songTitle) {
            songTitle.textContent = data.song;
          }
          if (artistName) {
            artistName.textContent = data.artist;
          }
          if (songLink) {
            songLink.href = data.songUrl;
          }

          const progressWrapper = card.querySelector(
            '#spotify-progress-wrapper',
          ) as HTMLElement;
          const progressFill = card.querySelector(
            '#spotify-progress-fill',
          ) as HTMLElement;
          const currentTimeSpan = card.querySelector(
            '#spotify-current-time',
          ) as HTMLElement;

          const formatTime = (ms: number) => {
            const seconds = Math.floor(ms / 1000);
            const minutes = Math.floor(seconds / 60);
            const secs = seconds % 60;
            return `${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
          };

          if (progressWrapper && progressFill && currentTimeSpan) {
            progressWrapper.setAttribute(
              'aria-valuemax',
              data.duration.toString(),
            );
            progressWrapper.setAttribute(
              'aria-valuenow',
              data.progress.toString(),
            );
            currentTimeSpan.textContent = formatTime(data.progress);

            const updateProgressBar = (progress: number, max: number) => {
              const percentage = (progress / max) * 100;
              progressFill.style.width = `${percentage}%`;
              progressWrapper.setAttribute(
                'aria-valuenow',
                progress.toString(),
              );
            };

            updateProgressBar(data.progress, data.duration);

            const initialProgress = data.progress;
            const loadTime = Date.now();
            const duration = data.duration;
            let animationFrameId: number;

            const updateProgress = () => {
              const elapsedMs = Date.now() - loadTime;
              let currentProgress = initialProgress + elapsedMs;

              if (currentProgress > duration) {
                currentProgress = duration;
              }

              currentTimeSpan.textContent = formatTime(currentProgress);
              updateProgressBar(currentProgress, duration);

              if (currentProgress < duration) {
                animationFrameId = requestAnimationFrame(updateProgress);
              } else {
                cancelAnimationFrame(animationFrameId);
              }
            };

            animationFrameId = requestAnimationFrame(updateProgress);
          }

          // Remove idle content and append player
          const idleIcon = spotifyElement.querySelector('svg');
          const idleText = spotifyElement.querySelector('.idle-text');
          const idleContainer = idleIcon?.parentElement;
          if (idleContainer) {
            idleContainer.remove();
          } else {
            idleIcon?.remove();
            idleText?.remove();
          }
          spotifyElement.appendChild(card);
        }
      }
    } catch {
      /* Spotify API unavailable */
    }
  });
</script>
