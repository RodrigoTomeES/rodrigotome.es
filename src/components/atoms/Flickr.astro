---
import { Image } from 'astro:assets';

import flickrService from '@/services/flickr';

import type { GetAlbumPhoto } from '@/services/flickr/types';

interface Props {
  class?: string;
}

let photos: GetAlbumPhoto[] = [];

try {
  photos = await flickrService.getAlbum(
    import.meta.env.FLICKR_PHOTOSET_ID,
    import.meta.env.FLICKR_USER_ID,
  );
} catch {
  /* Flickr API unavailable */
}

const displayPhotos = photos.slice(0, 6);
const { class: className } = Astro.props;
---

<section class:list={[className]} id="flickr" aria-label="Photography">
  <h2
    class="mb-6 text-xs font-semibold uppercase tracking-widest text-neutral-400"
  >
    Photography
  </h2>
  {
    displayPhotos.length > 0 ? (
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {displayPhotos.map((photo) => (
          <figure class="group relative overflow-hidden rounded-lg">
            <Image
              src={photo.url}
              alt={photo.title}
              height={photo.height}
              width={photo.width}
              class="aspect-square w-full object-cover transition-transform duration-300 group-hover:scale-105"
              widths={[240, 540]}
              sizes="(max-width: 640px) 50vw, 33vw"
            />
            <figcaption class="absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-black/60 to-transparent p-2 pt-6 transition-transform duration-300 group-hover:translate-y-0">
              <span class="line-clamp-1 text-xs text-white">{photo.title}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <p class="text-sm text-cv-muted">Photos unavailable</p>
    )
  }
</section>
