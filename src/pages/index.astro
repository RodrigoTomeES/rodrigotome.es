---
import { Image } from 'astro:assets';

import Description from '@/atoms/Description.astro';
import Flickr from '@/atoms/Flickr.astro';
import GitHub from '@/atoms/GitHub.astro';
import Links from '@/atoms/Links.astro';
import Spotify from '@/atoms/Spotify.astro';

import me from '@/assets/images/me.jpg';
import Layout from '../layouts/Layout.astro';

import type { OGImageOptions } from 'node_modules/astro-og-canvas/dist/types';

export const og: OGImageOptions = {
  title: 'Rodrigo Tomé',
  description: 'Rodrigo Tomé personal website.',
  logo: { path: './src/assets/images/me.jpg', size: [350] },
};
---

<Layout
  title="Rodrigo Tomé — Front End Lead at GUT"
  description="Passionate about building scalable interfaces and great developer experience. I lead the Fusion project working with React, Next.js, TypeScript, and Tailwind. Outside of code, I love traveling, photography, pop and 80s music, electronic beats, and trying new things."
>
  <main class="mx-auto max-w-[700px] px-6 py-16 md:py-24">
    <section class="mb-12">
      <Image
        src={me}
        alt="Rodrigo Tomé"
        class="mb-6 h-24 w-24 rounded-full object-cover"
        loading="eager"
        widths={[96, 192]}
        sizes="96px"
      />
      <Description />
      <Links class="mt-6" />
    </section>

    <hr class="border-cv-border" />
    <Spotify class="my-12" />
    <hr class="border-cv-border" />
    <GitHub class="my-12" />
    <hr class="border-cv-border" />
    <Flickr class="my-12" />
  </main>
</Layout>
